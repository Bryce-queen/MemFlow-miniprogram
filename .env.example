# ============================================================
# 记忆外挂 v2 — 环境变量模板
# 复制为 .env 并填入你的密钥
# ============================================================

# ── LLM API（标签提取 / 摘要 / 实体识别）──
# 智谱 AI: https://open.bigmodel.cn/
MEMORY_LLM_BASE=https://open.bigmodel.cn/api/paas/v4
MEMORY_LLM_KEY=你的智谱API密钥
MEMORY_LLM_MODEL=glm-4.5-air

# ── Embedding API（语义向量搜索）──
# 默认与 LLM 同源同 Key，也可单独配置
# MEMORY_EMBEDDING_BASE=
# MEMORY_EMBEDDING_KEY=
# MEMORY_EMBEDDING_MODEL=embedding-3
# MEMORY_EMBEDDING_DIM=1024

# ── API 安全 ──
# 设置后所有请求需带 X-API-Key 头，为空 = 本地开发模式
MEMORY_API_KEY=请生成一个随机字符串（如 openssl rand -hex 32）

# ── 限流 ──
# 每 IP 每分钟最大请求数，默认 60
# MEMORY_RATE_LIMIT=60

# ── 搜索权重 ──
# 0=纯语义, 1=纯关键词, 默认 0.5
# MEMORY_HYBRID_ALPHA=0.5
