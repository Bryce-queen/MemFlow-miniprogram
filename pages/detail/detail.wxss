/* ═══════════════════════════════
   详情页 · Midnight Luxe
   ═══════════════════════════════ */
.page {
  min-height: 100vh;
  background: #08080F;
  padding-bottom: 140rpx;
}

/* ── 页头 ── */
.detail-header {
  position: sticky;
  top: 0;
  z-index: 99;
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  padding-top: calc(20rpx + env(safe-area-inset-top));
  background: rgba(8,8,15,0.85);
  backdrop-filter: saturate(180%) blur(20rpx);
  -webkit-backdrop-filter: saturate(180%) blur(20rpx);
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.04);
  border: 1rpx solid #222240;
  margin-right: 20rpx;
  font-size: 32rpx;
}

.back-btn:active {
  background: rgba(255,255,255,0.08);
}

.detail-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: #EAEAF2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── AI 摘要 ── */
.summary-card {
  background: linear-gradient(160deg, rgba(212,168,83,0.1), rgba(212,168,83,0.02));
  border-left: 4rpx solid #D4A853;
  margin: 24rpx 28rpx;
  padding: 28rpx;
  border-radius: 0 20rpx 20rpx 0;
  position: relative;
  overflow: hidden;
}

.summary-card::before {
  content: 'AI 摘要';
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  font-size: 20rpx;
  color: rgba(212,168,83,0.5);
  font-weight: 600;
  letter-spacing: 1rpx;
}

.summary-text {
  font-size: 30rpx;
  color: #D4A853;
  line-height: 1.75;
}

/* ── 内容卡 ── */
.content-card {
  margin: 16rpx 28rpx;
  position: relative;
}

.content-text {
  font-size: 32rpx;
  color: #D8D8E8;
  line-height: 1.9;
  white-space: pre-wrap;
  word-break: break-all;
}

/* ── 编辑区 ── */
.edit-content-area {
  background: #111122;
  border-radius: 20rpx;
  padding: 24rpx;
  color: #EAEAF2;
  font-size: 30rpx;
  min-height: 240rpx;
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #222240;
  line-height: 1.8;
}

.edit-tags-input {
  background: #111122;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  color: #EAEAF2;
  font-size: 26rpx;
  border: 1rpx solid #222240;
  margin-top: 12rpx;
}

/* ── 实体标签行 ── */
.entity-row {
  padding: 12rpx 0 0;
}

.entity-chip {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 14rpx;
  margin: 6rpx 10rpx 6rpx 0;
  font-size: 20rpx;
  color: #9090A8;
  background: rgba(255,255,255,0.03);
  border-radius: 12rpx;
  border: 1rpx solid #222240;
}

/* ── 元信息卡 ── */
.meta-card {
  background: #0C0C18;
  margin: 24rpx 28rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid #1A1A30;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: #9090A8;
  border-bottom: 1rpx solid #181828;
}

.meta-row:last-child {
  border-bottom: none;
}

.meta-label {
  color: #585870;
  font-size: 22rpx;
}

.meta-value {
  color: #C0C0D0;
  max-width: 60%;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-value-sm {
  font-size: 20rpx;
  color: #585870;
  font-family: monospace;
}

/* ── 关联记忆 ── */
.related-section {
  margin-top: 24rpx;
}

.related-header {
  padding: 12rpx 32rpx 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #9090A8;
  letter-spacing: 1rpx;
}

/* ── 富化加载 ── */
.enrich-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.enrich-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid rgba(212,168,83,0.2);
  border-top-color: #D4A853;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
